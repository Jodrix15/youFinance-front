# URL base de la API.
#  - En desarrollo: dejar VACÍO para usar el proxy de Vite (/api -> VITE_API_TARGET).
#  - En producción (Vercel): dejar VACÍO también. El fichero vercel.json reescribe
#    /api/* hacia el backend de Render (mismo-origen, sin CORS).
#    Alternativa (sin vercel.json): VITE_API_BASE_URL=https://youfinance-back.onrender.com
VITE_API_BASE_URL=

# Destino del proxy de Vite SOLO en desarrollo (opcional).
# Por defecto http://localhost:8080 (backend Spring local).
# Si quieres pegar al backend de Render en dev, pon aquí su URL de Render (NO la del front).
VITE_API_TARGET=http://localhost:8080
